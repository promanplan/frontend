// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Subscription fields
  stripeCustomerId       String? @unique
  stripeSubscriptionId   String? @unique
  stripeCurrentPeriodEnd DateTime?

  // Relations
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  conversations Conversation[]
  documents     Document[]
  aiInteractions AIInteraction[]
  waitlist      WaitlistEntry?

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // User relation
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Project details
  industry    String?
  targetMarket String?
  businessModel String? @db.Text
  techStack   String?
  budget      Float?
  timeline    String?
  
  // Relations
  conversations Conversation[]
  documents     Document[]
  aiInteractions AIInteraction[]
  excalidrawFiles ExcalidrawFile[]

  @@map("projects")
}

model Conversation {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  content        String   @db.Text
  role           MessageRole
  createdAt      DateTime @default(now())
  
  // Relations
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  // AI metadata
  aiAgent       AIAgent?
  tokensUsed    Int?
  processingTime Int? // in milliseconds

  @@map("messages")
}

model Document {
  id          String   @id @default(cuid())
  title       String
  type        DocumentType
  content     String   @db.Text
  status      DocumentStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Document metadata
  version     Int      @default(1)
  isPublic    Boolean  @default(false)
  tags        String[]

  @@map("documents")
}

model AIInteraction {
  id          String   @id @default(cuid())
  type        AIInteractionType
  input       String   @db.Text
  output      String   @db.Text
  status      AIInteractionStatus @default(PENDING)
  createdAt   DateTime @default(now())
  completedAt DateTime?
  
  // Relations
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // AI metadata
  aiAgent     AIAgent
  tokensUsed  Int?
  processingTime Int? // in milliseconds
  cost        Float?
  model       String?

  @@map("ai_interactions")
}

model ExcalidrawFile {
  id          String   @id @default(cuid())
  name        String
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("excalidraw_files")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  company   String?
  role      String?
  createdAt DateTime @default(now())
  
  // Relations
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("waitlist_entries")
}

// Enums
enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum DocumentType {
  BUSINESS_MODEL
  PITCH_DECK
  SYSTEM_ARCHITECTURE
  UI_MOCKUP
  TECHNICAL_SPEC
  MARKETING_PLAN
  FINANCIAL_MODEL
  LEGAL_DOCUMENT
  OTHER
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum AIInteractionType {
  BUSINESS_ANALYSIS
  SYSTEM_ARCHITECTURE
  UI_DESIGN
  CODE_GENERATION
  PROJECT_MANAGEMENT
  MARKETING
  LEGAL_REVIEW
  GENERAL
}

enum AIInteractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AIAgent {
  BUSINESS_ANALYST
  SYSTEM_ARCHITECT
  UI_DESIGNER
  DEVELOPER
  PROJECT_MANAGER
  MARKETING_SPECIALIST
  LEGAL_ADVISOR
  GENERAL_ASSISTANT
}
